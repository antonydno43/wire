# ==============================================================================
# YourBiz CRM Environment Variables (Add these in Vercel Project Settings)
# ==============================================================================

# --- Client-Side Public Variables (Exposed to Vite Browser Bundle) ---
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=""

# Your Supabase Anonymous Public Key (safe for browser with RLS enabled)
VITE_SUPABASE_ANON_KEY=""

# Public App URL used for invite & confirmation links (e.g., https://yourbizcrm.com)
VITE_APP_URL="http://localhost:3000"

# --- Server-Side Private Variables (Vercel Serverless /api/* & Express server.ts) ---
# Supabase URL (same as VITE_SUPABASE_URL, used by /api/* functions)
SUPABASE_URL=""

# Supabase Service Role Key (Optional but recommended for server-side invite verification)
SUPABASE_SERVICE_ROLE_KEY=""

# Resend API Key for transactional welcome & workspace invitation emails (https://resend.com)
RESEND_API_KEY=""

# Verified Sender Email in Resend (e.g., "YourBiz CRM <hello@yourdomain.com>")
# For quick testing with Resend sandbox, use: "YourBiz CRM <onboarding@resend.dev>"
RESEND_FROM_EMAIL="YourBiz CRM <onboarding@resend.dev>"

# Support inbox where /queries form submissions are forwarded via Resend
SUPPORT_NOTIFY_EMAIL=""

# Server App Base URL (used in email links)
APP_URL="http://localhost:3000"
